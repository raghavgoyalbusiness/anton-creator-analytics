{
  "name": "@anton/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --build",
    "dev": "tsx watch src/index.ts",
    "db:seed": "tsx src/scripts/seed.ts",
    "db:reset": "tsx src/scripts/seed.ts --reset",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "mint": "tsx src/scripts/mint-link.ts",
    "extract": "tsx src/scripts/extract.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.70.1",
    "@anton/shared": "*",
    "@aws-sdk/client-s3": "^3.1116.0",
    "@aws-sdk/s3-request-presigner": "^3.1116.0",
    "@node-rs/argon2": "^2.1.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "mongoose": "^8.20.1",
    "otpauth": "^9.5.1",
    "sharp": "^0.34.5",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.19.0",
    "@types/supertest": "^6.0.3",
    "mongodb-memory-server": "^10.2.5",
    "supertest": "^7.2.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
