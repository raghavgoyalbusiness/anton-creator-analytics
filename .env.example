# Copy to .env and fill in. Nothing here is read by the browser bundle:
# every secret is server-side only.

NODE_ENV=development
PORT=5310
WEB_ORIGIN=http://localhost:5210

# Leave MONGODB_URI unset in development to boot an in-process MongoDB,
# persisted at MONGO_DEV_DB_PATH. Set it to an Atlas URI for anything real.
# MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/anton
MONGO_DEV_DB_PATH=.mongo-data

# Vision extraction. Server-side only; never exposed to the client.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Screenshot storage. 'local' signs short-lived HMAC URLs served by Express;
# 's3' uses real presigned URLs against a PRIVATE bucket. Same interface.
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=.storage
# S3_BUCKET=
# S3_REGION=eu-west-2
# S3_ENDPOINT=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# Signs magic-link tokens, share tokens and local presigned URLs.
# Generate with: openssl rand -base64 48
TOKEN_SECRET=dev-only-insecure-secret-change-me-please!!

# Salt for the one-way consent IP hash. Generate with: openssl rand -hex 32
IP_HASH_SALT=dev-only-ip-salt-change-me

# Bump when CONSENT.md changes materially; creators are re-asked.
CONSENT_SCOPE_VERSION=2026-08-v1
